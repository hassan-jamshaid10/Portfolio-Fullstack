# Supabase / Postgres (Kysely)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.jjikolkpycrzdgcfulrl.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://jjikolkpycrzdgcfulrl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# CRM auth (single-admin password gate)
CRM_PASSWORD=change-me
CRM_SESSION_SECRET=replace-with-long-random-string

# Vercel cron (must match Vercel project env CRON_SECRET)
CRON_SECRET=replace-with-long-random-string

# Composio project API key (ak_…) — preferred for this CRM
# Also supports consumer MCP keys (ck_…) automatically
COMPOSIO_API_KEY=ak_xxxxxxxx
COMPOSIO_WORKSPACE=hjamshaid81_workspace
COMPOSIO_USER_ID=pg-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
COMPOSIO_LINKEDIN_CONNECTED_ACCOUNT_ID=
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
COMPOSIO_APOLLO_CONNECTED_ACCOUNT_ID=

# Apollo Free does NOT include People/Org Search or Enrichment APIs (even with a master key).
# Paid Apollo is required for email unlock via Composio. Free intake uses Jobicy + Arbeitnow.
# Set to 1 to skip Apollo calls entirely (recommended on Apollo Free):
COMPOSIO_SKIP_APOLLO=1
# APOLLO_API_KEY= (unused for free-plan search)

# Fallback inbox when a lead has no company email (sends prepared application to you)
CRM_APPLY_TO_EMAIL=hjamshaid81@gmail.com

# Optional: public site URL for cron callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SLACK_CRM_CHANNEL=crm-leads
